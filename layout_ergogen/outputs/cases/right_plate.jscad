                function right_plate_case_fn() {
                    

                // creating part outline of case right_plate
                let right_plate__part_outline = _r_key_cutouts_extrude_1_outline_fn();

                // make sure that rotations are relative
                let right_plate__part_outline_bounds = right_plate__part_outline.getBounds();
                let right_plate__part_outline_x = right_plate__part_outline_bounds[0].x + (right_plate__part_outline_bounds[1].x - right_plate__part_outline_bounds[0].x) / 2
                let right_plate__part_outline_y = right_plate__part_outline_bounds[0].y + (right_plate__part_outline_bounds[1].y - right_plate__part_outline_bounds[0].y) / 2
                right_plate__part_outline = translate([-right_plate__part_outline_x, -right_plate__part_outline_y, 0], right_plate__part_outline);
                right_plate__part_outline = rotate([0,0,0], right_plate__part_outline);
                right_plate__part_outline = translate([right_plate__part_outline_x, right_plate__part_outline_y, 0], right_plate__part_outline);

                right_plate__part_outline = translate([0,0,0], right_plate__part_outline);
                let result = right_plate__part_outline;
                
            
                    return result;
                }
            
            
        
            function main() {
                return right_plate_case_fn();
            }

        