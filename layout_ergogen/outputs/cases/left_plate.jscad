                function left_plate_case_fn() {
                    

                // creating part outline of case left_plate
                let left_plate__part_outline = _l_key_cutouts_extrude_1_outline_fn();

                // make sure that rotations are relative
                let left_plate__part_outline_bounds = left_plate__part_outline.getBounds();
                let left_plate__part_outline_x = left_plate__part_outline_bounds[0].x + (left_plate__part_outline_bounds[1].x - left_plate__part_outline_bounds[0].x) / 2
                let left_plate__part_outline_y = left_plate__part_outline_bounds[0].y + (left_plate__part_outline_bounds[1].y - left_plate__part_outline_bounds[0].y) / 2
                left_plate__part_outline = translate([-left_plate__part_outline_x, -left_plate__part_outline_y, 0], left_plate__part_outline);
                left_plate__part_outline = rotate([0,0,0], left_plate__part_outline);
                left_plate__part_outline = translate([left_plate__part_outline_x, left_plate__part_outline_y, 0], left_plate__part_outline);

                left_plate__part_outline = translate([0,0,0], left_plate__part_outline);
                let result = left_plate__part_outline;
                
            
                    return result;
                }
            
            
        
            function main() {
                return left_plate_case_fn();
            }

        